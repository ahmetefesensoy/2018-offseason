<?xml version="1.0"?>
<package format="3">
  <name>frc_world_model</name>
  <version>0.1.0</version>
  <description>Deterministic semantic tracking and world snapshots for FRC autonomy.</description>
  <maintainer email="robotics@example.com">FRC Autonomy Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>frc_autonomy_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
